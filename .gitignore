# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.pyo
*.egg-info/
build/
dist/

# Virtual Environment
.venv
venv
env

# IDE / Editor Files
.idea/             # JetBrains (PyCharm, IntelliJ)
*.swp
*.bak
.vscode/

# Machine Learning / Data Files
data/*.pkl         # Trained models (must be generated, not stored)
data/*.csv         # Raw/Historical data files
.DS_Store          # macOS file

# Secret and Log Files
*.log
*.sqlite3
.env               # For environment variables like OPENAI_API_KEY (if used)